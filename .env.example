# Production deployments can store the full private contact TOML in this
# runtime secret. Local development can use the ignored server TOML file.
CONTACT_INFO_TOML=

# Admin contact access
# Store the original random access key in a password manager and put only its
# lowercase SHA-256 digest here. Both signing secrets must be base64url encoded,
# decode to at least 32 random bytes, and remain separate.
CONTACT_ADMIN_KEY_SHA256=
CONTACT_ADMIN_SESSION_SECRET=
CONTACT_ADMIN_SESSION_VERSION=1
CONTACT_GRANT_SECRET=
